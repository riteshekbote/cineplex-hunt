+# Droppable only when they leave the remainder balanced, so a closed
+# GraphQL query such as ``?query={__typename}`` keeps its closing brace.
+TRAILING_BRACKET = ")]}"
 MAX_URL = 600
 DEFAULT_CAP = 12
 
