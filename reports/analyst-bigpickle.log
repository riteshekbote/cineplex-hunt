import re, glob, ssl, urllib.request, os, time
allow=os.environ.get('PROBE_ALLOW','').lower()
pat=re.compile(r'https?://[^\s"\)\]]+')
urls,seen=[],set()
for f in glob.glob('art/lead_*.txt')+glob.glob('lead_*.txt')+glob.glob('analyst-*.out'):
    try: txt=open(f,errors='ignore').read()
    except OSError: continue
    for m in pat.findall(txt):
        # keep GraphQL braces (query={__typename}) but drop trailing prose punctuation
        u=m.strip('.,;)]>`') if '{' in m else m.strip('.,;)]}>`')
        if u.count('{')>u.count('}'):
            u=u.rstrip('.,;')+('}'*(u.count('{')-u.count('}')))
        if u in seen or not u.startswith('https://'): continue
        seen.add(u)
        if allow and not any(a in u.lower() for a in allow.split('|')): continue
        urls.append(u[:300])
ctx=ssl.create_default_context(); rows=[]
ua=os.environ.get('PROBE_UA') or 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36'
for u in urls:
    time.sleep(1)
    try:
        req=urllib.request.Request(u,method='HEAD',headers={'User-Agent':ua})
        with urllib.request.urlopen(req,timeout=12,context=ctx) as r:
            rows.append('%s -> %s len=%s'%(u,r.status,r.headers.get('Content-Length','?')))
    except urllib.error.HTTPError as e:
        rows.append('%s -> HTTP %s'%(u,e.code))
    except Exception as e:
        rows.append('%s -> ERR %s'%(u,str(e)[:50]))
print('\n'.join(rows) if rows else 'no probes (allow=%s)'%allow)
print('probed %d/%d candidate URLs (no cap; dedup applied)'%(len(rows),len(urls)))
with open('probe-results.md','a') as fo:
    fo.write('\n## %s\ncandidates=%d probed=%d ua=%s\n%s\n'%(time.strftime('%Y-%m-%d %H:%M:%S UTC',time.gmtime()),len(urls),len(rows),ua,'\n'.join(rows)))
