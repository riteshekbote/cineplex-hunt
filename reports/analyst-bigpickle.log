import json,re
d=json.load(open('mut.json'))['data']['__type']['fields']
def tn(t):
    if t is None: return '?'
    k=t['kind']
    if k=='NON_NULL': return tn(t['ofType'])+'!'
    if k=='LIST': return '['+tn(t['ofType'])+']'
    return t['name']
def sig(f):
    return f["name"]+"("+", ".join(f"{a['name']}:{tn(a['type'])}" for a in f['args'])+")"
money=re.compile(r'paypal|payment|price|amount|subscri|voucher|ticket|bonus|points|coupon|promo|refund|invoice|order|free|campaign|discount|confirm',re.I)
print("=== MONEY / ENTITLEMENT-SHAPED MUTATIONS ===")
for f in d:
    if money.search(f['name']): print(" *",sig(f), "DEPRECATED" if f['isDeprecated'] else "")
print("\n=== CREDENTIAL / AUTH-SHAPED MUTATIONS ===")
for f in d:
    if re.search(r'login|password|token|email|user|admin|delete|store|consent|sdk|register',f['name'],re.I): print(" *",sig(f),"DEPRECATED" if f['isDeprecated'] else "")
