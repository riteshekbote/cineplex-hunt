+# Retracted findings stay in the append-only lead history as [HYP] blocks, so
+# parse_blocks keeps re-finding them forever. Honor retractions explicitly:
+# SUPPRESS_FILE lists asset|class pairs or bare fingerprints; suppressed blocks
+# are never created, and matching open issues are reported (and closed only
+# when CLOSE_SUPPRESSED=1) so a falsified finding cannot sit in the tracker.
+suppressed_pairs, suppressed_fps = set(), set()
+sup_path = Path(SUPPRESS_FILE)
+if sup_path.exists():
+    for ln in sup_path.read_text(errors="ignore").splitlines():
+        ln = ln.strip()
+        if not ln or ln.startswith("#"):
+            continue
+        if re.fullmatch(r'[0-9a-f]{12}', ln):
+            suppressed_fps.add(ln)
+        elif "|" in ln:
