+# Same finding, cosmetic asset-string differences -> duplicate issues.
+# fingerprint is md5(asset|class), so "web-dev.cineplex.de" vs an empty
+# asset vs "wildcard.systems.cineplex.de" for one dangling-CNAME finding each
+# hash differently. Collapse on class + title similarity, but union the asset
+# lists so no affected host is dropped from the issue body.
+collapsed = []
+for b in uniq_blocks:
+    bc = (b.get("class", "OTHER") or "OTHER").strip().lower()[:20]
+    bt = norm_title(b.get("title", ""))
+    hit = None
+    for k in collapsed:
+        if (k.get("class", "OTHER") or "OTHER").strip().lower()[:20] != bc:
+            continue
+        if SequenceMatcher(None, norm_title(k.get("title", "")), bt).ratio() >= TITLE_SIM_THRESHOLD:
+            hit = k
+            break
+    if hit is None:
+        collapsed.append(b)
+    else:
+        merged = [a for a in (str(hit.get("asset", "")).split("+") +
+                              str(b.get("asset", "")).split("+")) if a.strip()]
+        uniq = list(dict.fromkeys(x.strip() for x in merged if x.strip()))
+        hit["asset"] = " + ".join(uniq)
+if len(collapsed) != len(uniq_blocks):
+    print(f"near-duplicate collapse: {len(uniq_blocks)} -> {len(collapsed)}")
+uniq_blocks = collapsed
+
