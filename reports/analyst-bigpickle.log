+VALID_CLASSES = {
+    "MISCONFIG", "AUTH", "IDOR", "BUSLOGIC", "SSRF", "OTHER",
+    "SUBDOMAIN_TAKEOVER", "INJECTION", "XSS", "CRYPTO", "PRIVACY",
+}
+
+
+def norm_class(c):
+    """Normalize a class value, rejecting malformed ones.
+
+    Lead files occasionally carry two KV pairs on one physical line, e.g.
+    ``class: 'MISCONFIG' conf: '93'``. The old behaviour took the whole
+    remainder as the class, minting a bogus fingerprint per variant. Strip the
+    stray quotes/extra pairs and fall back to OTHER when nothing valid remains.
+    """
+    c = (c or "").strip()
+    if not c:
+        return "OTHER"
+    # take only the first whitespace-separated token, then unwrap quotes
+    c = c.split()[0].strip().strip("'\"").upper()
+    # a stray value like ``'MISCONFIG'`` -> MISCONFIG; ``conf:`` -> invalid
+    c = c.split(":")[0].strip().strip("'\"")
+    return c if c in VALID_CLASSES else "OTHER"
+
+
+def canonical_asset(a):
+    """Reduce an asset string to the finding's real subject.
+
+    Analysts spell the same asset several ways -- ``web-dev.cineplex.de``,
+    ``web-dev.cineplex.de -> web.gentleglacier-....azurecontainerapps.io``,
+    ``https://web-dev.cineplex.de.`` -- and each spelling used to produce a
+    distinct fingerprint, so one dangling CNAME fanned out into several
+    near-identical issues. Keep only the host (and path when the asset is a
+    URL, which is how distinct paths are separated).
+    """
+    a = (a or "").strip().lower().strip("`").strip()
+    a = re.sub(r'^((get|post|put|patch|delete|head|options)s?)\s+', '', a, flags=re.I)
+    # drop a leading scheme and any userinfo
+    a = re.sub(r'^[a-z][a-z0-9+.-]*://', '', a)
+    a = a.split("@")[-1]
+    # cut the asset at an arrow / bullet separator and keep the left side
+    a = re.split(r'\s*(?:->|=>|→|←|<-|\||—|–)\s*', a)[0]
+    # drop any parenthesised annotation and brace expansions
+    a = re.sub(r'\(.*?\)', ' ', a)
+    a = re.sub(r'\{.*?\}', ' ', a)
+    host = a.split('/')[0].strip().strip('.')
+    if host:
+        return host
+    return a.strip()[:120]
+
+
