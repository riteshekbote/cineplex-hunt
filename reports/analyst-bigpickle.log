import re
from pathlib import Path

STARTS = tuple(f"[{t}]" for t in ("HYP","LEARN","PARKED","FINAL","NEXT","RISK","NEW","CHANGED","PRIO"))
ORPHAN  = "class: 'MISCONFIG' conf: '93'"

IDOR_ASSERT = re.compile(r'\b(IDOR|BOLA)\b|ownership (?:check|omission)|missing ownership', re.I)
IMPACT_CTX  = re.compile(r'enabl|idor-capable|leads? to|which would|downstream|follow-on|unlocks', re.I)
DECODER     = re.compile(r'decoder contracts|decode entity ids|decoder reach|decoder oracle', re.I)
DEV_ORIGIN  = re.compile(r'dev-origin|gateway maintenance-exit|maintenance-lift', re.I)
# surviving Low decoder oracle must not be filed under the falsified IDOR class
RECLASS_DECODER = re.compile(r'^\[HYP\]\s*15 resolvers across 4 decoder contracts', re.I)

files = [Path('leads/lead-bigpickle.md'), Path('leads/lead-nemotron3.md')]
tally = dict(fused=0, orphan=0, relearn=0, reparked=0, reclass=0)

for f in files:
    L = f.read_text(errors='replace').splitlines()
    out = []
    for i, line in enumerate(L):
        # 1. drop the malformed single-line attribute (parser-input defect: KV
        #    captured "'MISCONFIG' conf: '93'" and overwrote the real class)
        if line.strip() == ORPHAN:
            tally['orphan'] += 1
            continue
        # 2. separate fused block headers so attributes stop bleeding between findings
        if line.startswith(STARTS) and out and out[-1].strip() != '':
            out.append('')
            tally['fused'] += 1
        # 3. suppress falsified IDOR/BOLA framings; keep the decoder oracle
        if line.startswith('[HYP]'):
            t = line[5:].strip()
            if IDOR_ASSERT.search(t) and not DECODER.search(t):
                if DEV_ORIGIN.search(t):
                    line = '[PARKED]' + line[5:]
                    tally['reparked'] += 1
                else:
                    line = '[LEARN]' + line[5:]
                    tally['relearn'] += 1
        out.append(line)
        # 4. surviving decoder oracle: file under ACCESS_CONTROL, not the falsified IDOR
        if RECLASS_DECODER.match(line) and out[-2:-1] and out[-2].strip() == 'class: IDOR':
            out[-1] = 'class: ACCESS_CONTROL'
            tally['reclass'] += 1
    f.write_text('\n'.join(out) + '\n')

print("remediation applied:")
for k, v in tally.items():
    print(f"  {k:9} {v}")
