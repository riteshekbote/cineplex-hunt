+def load_retractions(path=RETRACTIONS_FILE):
+    """Load claim-level retractions. A retraction suppresses one falsified
+    claim without touching the rest of the corpus. Absence of the file is
+    not an error: retractions are opt-in and additive."""
+    p = Path(path)
+    if not p.exists():
+        return []
+    try:
+        data = json.loads(p.read_text())
+    except (ValueError, OSError) as e:
+        raise SystemExit(f"cannot read retractions from {path}: {e}")
+    if isinstance(data, dict):
+        data = data.get("retractions", [])
+    if not isinstance(data, list):
+        raise SystemExit(f"{path}: expected a list or {{'retractions': [...]}}")
+    for r in data:
+        if not isinstance(r, dict) or not r.get("id"):
+            raise SystemExit(f"{path}: every retraction needs an 'id'")
+    return data
+
+
+def retraction_for(block, retractions, fp=None):
+    """Return the first retraction matching this block, else None.
+
+    Match precedence, most specific first:
+      fingerprint        exact asset+class fingerprint
+      title_contains     all substrings present (case-insensitive)
+    Optional qualifiers narrow a match further:
+      asset_contains     substring of the normalized asset
+      title_excludes     any substring present -> no match (spare-list)
+      confidence_at_most only retract up to this confidence
+    """
+    fp = fp or fingerprint(block)
+    title = (block.get("title", "") or "").lower()
+    asset = norm_asset(block.get("asset", "")).lower()
+    for r in retractions:
+        if r.get("fingerprint") and r["fingerprint"] != fp:
+            continue
+        need_asset = r.get("asset_contains")
+        if need_asset and need_asset.lower() not in asset:
+            continue
+        need = r.get("title_contains")
+        if need and not all(s.lower() in title for s in need):
+            continue
+        skip = r.get("title_excludes")
+        if skip and any(s.lower() in title for s in skip):
+            continue
+        cap = r.get("confidence_at_most")
+        if cap is not None:
+            try:
+                if int(block.get("confidence", 0) or 0) > int(cap):
+                    continue
+            except (TypeError, ValueError):
+                pass
+        return r
+    return None
+
+
+def collect_blocks(files, glob_pattern=GLOB):
+    """Parse every lead file into blocks. Single entry point so that the
+    audit and the publish path can never disagree about the corpus."""
+    blocks = []
+    for f in files:
+        text = f.read_text(errors="ignore")
+        mh = re.search(r'\(model\s+(\w+)\)', text)
+        model = mh.group(1) if mh else ("unknown")
+        if model == "unknown" and MODEL_FROM_FILENAME:
+            mf = re.match(r'(\w+)', f.name)
+            model = mf.group(1) if mf else "unknown"
+        blocks += parse_blocks(text, model)
+    return blocks
+
+
+def audit(files, retractions):
+    """Offline corpus report. Executing the publisher's own parser is the
+    only trustworthy way to state what is on the publish path; reading a
+    single lead file by hand is not a measurement of the system."""
+    blocks = collect_blocks(files)
+    live = [b for b in blocks if not retraction_for(b, retractions)]
+    retracted = [b for b in blocks if retraction_for(b, retractions)]
+
+    def conf(b):
+        v = b.get("confidence", 0) or 0
+        try:
+            return int(v)
+        except (TypeError, ValueError):
+            try:
+                return int(float(v))
+            except (TypeError, ValueError):
+                return 0
+
+    def fps(bs):
+        return {fingerprint(b) for b in bs}
+
+    print(f"files: {len(files)}  blocks: {len(blocks)}")
+    print(f"  retracted : {len(retracted):5d} blocks / {len(fps(retracted)):3d} fingerprints")
+    print(f"  live      : {len(live):5d} blocks / {len(fps(live)):3d} fingerprints")
+    print(f"  distinct live titles: {len({norm_title(b.get('title','')) for b in live})}")
+
+    by_ret = {}
+    for b in retracted:
+        by_ret.setdefault(retraction_for(b, retractions)["id"], []).append(b)
+    for rid, bs in sorted(by_ret.items()):
+        print(f"  retraction {rid}: {len(bs)} blocks / {len(fps(bs))} fingerprints")
+
+    print("\nlive blocks by class:")
+    counts = {}
+    for b in live:
+        k = (b.get("class") or "OTHER").strip().upper()[:20]
+        counts[k] = counts.get(k, 0) + 1
+    for k, n in sorted(counts.items(), key=lambda kv: -kv[1]):
+        print(f"  {n:5d}  {k}")
+
+    print("\nlive fingerprints at confidence >= 80:")
+    seen = {}
+    for b in live:
+        if conf(b) >= 80:
+            seen.setdefault(fingerprint(b), b)
+    for fp, b in sorted(seen.items(), key=lambda kv: -conf(kv[1])):
+        print(f"  {fp} c{conf(b):3d} {coarse_target(b.get('asset',''))[:46]:46s} "
+              f"{b.get('title','')[:64]}")
+    print(f"  -> {len(seen)} high-confidence live fingerprints")
+    return blocks, live, retracted
+
