import io, contextlib, sys
sys.path.insert(0,'/tmp/opencode')
buf = io.StringIO()
with contextlib.redirect_stdout(buf):
    from groups import parse_blocks, ROOT
from collections import defaultdict
import triage_rules as T

blocks=[]
for f in sorted(ROOT.glob("leads/lead-*.md")):
    blocks += parse_blocks(f.read_text(errors="replace"), f.stem, f.name)
buckets=defaultdict(list)
for b in blocks: buckets[T.classify(b)].append(b)
print("total", len(blocks))
for k,v in sorted(buckets.items(), key=lambda kv:-len(kv[1])):
    print(f"{len(v):5d}  {k}")
print("\n--- REVIEW bucket (needs manual decision):")
for b in buckets.get("REVIEW", []):
    print(f"  {b['file']}:{b['line']} class={(b.get('class') or '?')!r} asset={(b.get('asset') or '-')[:40]!r} {b['title'][:80]!r}")
print("\n--- DECODER_SURVIVOR bucket:")
for b in buckets.get("DECODER_SURVIVOR", []):
    print(f"  {b['file']}:{b['line']} class={(b.get('class') or '?')!r} {b['title'][:88]!r}")
EOF
