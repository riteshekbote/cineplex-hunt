#!/bin/bash
UA='Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/140.0.0.0 Safari/537.36'
probe(){ # $1=host $2=path $3=query
  local out code len
  out=$(curl -s --http2 --max-time 20 -A "$UA" -H 'Accept: application/json' -G "https://$1$2" --data-urlencode "query=$3" -w '\n__M__%{http_code} %{size_download} %{header_json}' 2>/dev/null)
  code=$(printf '%s' "$out" | tail -1 | sed 's/__M__//' | awk '{print $1}')
  len=$(printf '%s' "$out" | tail -1 | sed 's/__M__//' | awk '{print $2}')
  local body=$(printf '%s' "$out" | sed '$d')
  local pw=$(printf '%s' "$out" | tail -1 | grep -o 'x-powered-by[^,]*' | head -1)
  local ext=$(printf '%s' "$body" | jq -r 'if .errors then (.errors[0].extensions.code // "no-code") else "RESOLVED" end' 2>/dev/null)
  local msg=$(printf '%s' "$body" | jq -r 'if .errors then (.errors[0].message // "") else "" end' 2>/dev/null | head -c 90)
  printf '%-38s %-14s HTTP %s %6sB  %-22s %s | %s\n' "$1" "$2" "$code" "$len" "$ext" "$pw" "$msg"
}
EOF
