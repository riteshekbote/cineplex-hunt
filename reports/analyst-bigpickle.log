def q(name,typ='A'):
    url=f'https://cloudflare-dns.com/dns-query?name={name}&type={typ}'
    r=urllib.request.Request(url,headers={'accept':'application/dns-json'})
    try:
        with urllib.request.urlopen(r,timeout=15,context=ctx) as f: return json.load(f)
    except Exception as e: return {'Status':-1,'err':str(e)[:60]}
