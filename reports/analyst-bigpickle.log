import sys, types, importlib.util, glob, collections, hashlib
g=types.ModuleType('github'); g.Github=object; sys.modules['github']=g
spec=importlib.util.spec_from_file_location('si','scripts/sync-issues.py')
s=importlib.util.module_from_spec(spec); spec.loader.exec_module(s)
allb=[]
for f in sorted(glob.glob('leads/lead-*.md')):
    m=f.split('lead-')[1].replace('.md','')
    for b in s.parse_blocks(open(f,encoding='utf-8',errors='replace').read(), m):
        b['_f']=f; allb.append(b)
print('blocks per file:', collections.Counter(b['_f'] for b in allb))
print()
def key(b):
    t=b['title']
    t=' '.join(t.lower().split()[:9])
    return (str(b.get('class','?')).upper(), t)
c=collections.Counter(key(b) for b in allb)
print('distinct (class,title-prefix):', len(c))
for k,v in c.most_common(30): print('  %4d  %s' % (v,k))
print()
fp=set()
for b in allb:
    try: fp.add(s.fingerprint(b))
    except Exception as e: fp.add(('err',str(e)[:40]))
print('distinct fingerprints:', len(fp))
print()
for cls in ('IDOR','AUTH'):
    n=sum(1 for b in allb if str(b.get('class','')).upper()==cls)
    print(cls,'blocks:',n)
