# Build a fake issue that mirrors one retracted lead and one live lead.
def mkissue(title, target, cls, conf, state="open", num=1):
    body = (f"## Title\n{title}\n\n## Target\n`{target}`\n\n## Class\n{cls}\n\n"
            f"## Confidence\n{conf}/100\n\n## Reasoning\nx\n")
    return types.SimpleNamespace(title=title, body=body, state=state, number=num,
                                 labels=[types.SimpleNamespace(name="pending")], _edits=[])

RETRACT_TITLE = "Systemic Unauthenticated IDOR Across 4 Single-Entity Resolvers via decodePublicId-Before-Gate"
SURVIVOR_TITLE = "The pre-auth id-decode family is a decoder oracle, not a demonstrated IDOR"
JUNK_TITLE = "Dev-origin /gateway maintenance-exit"

existing = [mkissue(RETRACT_TITLE, "graphql-api.app.cineplex.de", "IDOR", 96, num=1),
            mkissue(SURVIVOR_TITLE, "graphql-api.app.cineplex.de", "IDOR", 80, num=2),
            mkissue(JUNK_TITLE, "buchung-dev.cineplex.de", "AUTH", 40, num=3)]

created, edited = [], []
class FakeRepo:
    def get_issue(self, n): return None
    def get_label(self, n): return types.SimpleNamespace(name=n)
    def create_label(self, n, c): pass
    def get_issues(self, state="all", labels=None): return existing
    def create_issue(self, title, body, labels): created.append((title, body))
class FakeGithub:
    def __init__(self, tok): pass
    def get_repo(self, name): return FakeRepo()
mod = types.ModuleType("github"); mod.Github = FakeGithub
sys.modules["github"] = mod

for iss in existing:
    iss.edit = lambda **kw: edited.append((iss.number, kw))

si.REPO, si.TOKEN = "x/y", "t"
si.main()
print("\n" + "="*60)
print("created issues:", len(created))
print("edited issues :", [(n, k.get('state')) for n,k in edited])
