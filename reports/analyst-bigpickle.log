parse_blocks, fingerprint = ns["parse_blocks"], ns["fingerprint"]

grand_cls = collections.Counter()
rows = []
for p in sorted(Path("leads").glob("lead-*.md")):
    blocks = parse_blocks(p.read_text(errors="replace"), p.stem.replace("lead-",""))
    cls = collections.Counter((b.get("class","OTHER") or "OTHER").strip().upper() for b in blocks)
    grand_cls.update(cls)
    rows.append((p.name, len(blocks), cls))

