     """Reduce an asset string to the finding's real subject.
 
     Analysts spell the same asset several ways -- ``web-dev.cineplex.de``,
     ``web-dev.cineplex.de -> web.gentleglacier-....azurecontainerapps.io``,
-    ``https://web-dev.cineplex.de.`` -- and each spelling used to produce a
-    distinct fingerprint, so one dangling CNAME fanned out into several
-    near-identical issues. Keep only the host (and path when the asset is a
-    URL, which is how distinct paths are separated).
+    ``https://web-dev.cineplex.de.``, ``graphql-api.app.{,staging.}cineplex.de``
+    -- and each spelling used to produce a distinct fingerprint, so one
+    dangling CNAME fanned out into several near-identical issues.
+
+    Only *decoration* is stripped: scheme/userinfo, trailing dot, a redirect or
+    CNAME target after ``->``/``=>``, brace expansions (first alternative),
+    parenthesised annotations and HTTP-verb prefixes. The path, the host and any
+    trailing description are kept, because those are what actually distinguish
+    two different findings on the same host.
     """
     a = (a or "").strip().lower().strip("`").strip()
     a = re.sub(r'^((get|post|put|patch|delete|head|options)s?)\s+', '', a, flags=re.I)
-    # drop a leading scheme and any userinfo
     a = re.sub(r'^[a-z][a-z0-9+.-]*://', '', a)
     a = a.split("@")[-1]
-    # cut the asset at an arrow / bullet separator and keep the left side
-    a = re.split(r'\s*(?:->|=>|→|←|<-|\||—|–)\s*', a)[0]
-    # drop any parenthesised annotation and brace expansions
-    a = re.sub(r'\(.*?\)', ' ', a)
-    a = re.sub(r'\{.*?\}', ' ', a)
-    host = a.split('/')[0].strip().strip('.')
-    if host:
-        return host
-    return a.strip()[:120]
+    # drop a redirect/CNAME target introduced by an arrow
+    a = re.split(r'\s*(?:->|=>|→|←|<-)\s*', a)[0]
+    # drop parenthesised annotations, keeping the surrounding text
+    a = re.sub(r'\s*\([^)]*\)', ' ', a)
+    # brace expansion: {a,b}c -> ac  (one logical asset, keep first alternative)
+    for _ in range(3):
+        m = re.search(r'\{([^{}]*)\}', a)
+        if not m:
+            break
+        first = m.group(1).split(',')[0].split('|')[0]
+        a = a[:m.start()] + first + a[m.end():]
+    a = re.sub(r'\s+', ' ', a).strip()
+    a = a.strip(' ,;')
+    # a trailing bare FQDN (leftover CNAME/origin) adds no new finding identity
+    return a[:120]
 
 
