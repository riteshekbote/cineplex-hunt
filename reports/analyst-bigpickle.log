+def issue_as_block(iss):
+    """Project a published issue back into block shape so that the same
+    retraction matcher governs both incoming leads and existing issues."""
+    body = iss.body or ""
+
+    def sect(name):
+        m = re.search(rf'^## {name}\n(.*)$', body, re.M)
+        return m.group(1).strip().strip("`") if m else ""
+
+    conf_m = re.search(r'^## Confidence\n(\d+)', body, re.M)
+    return {
+        "title": sect("Title") or (iss.title or ""),
+        "asset": sect("Target"),
+        "class": sect("Class") or "OTHER",
+        "confidence": conf_m.group(1) if conf_m else 0,
+    }
+
+
