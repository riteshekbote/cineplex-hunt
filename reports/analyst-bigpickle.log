for f in sorted(Path(".").glob("leads/lead-*.md")):
    t=f.read_text(errors="ignore")
    mh=re.search(r'\(model\s+(\w+)\)',t)
    model=mh.group(1) if mh else "unknown"
    blocks+=mod.parse_blocks(t,model)
print("raw blocks:",len(blocks))
kept=mod.publishable(blocks)
print("kept:",len(kept))
seen=set();uniq=[]
for b in kept:
    fp=mod.fingerprint(b)
    if fp not in seen: seen.add(fp); uniq.append(b)
print("unique fingerprints published:",len(uniq))
res=[u for u in uniq if 'idor' in mod.norm_title(u.get('title',''))]
print("IDOR-titled surviving:",len(res))
for u in res: print("   ",mod.block_conf(u),u.get('title','')[:75])
