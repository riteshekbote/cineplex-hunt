 STOP = re.compile(r'^\[(HYP|PARKED|FINAL|NEXT|LEARN|RISK|NEW|CHANGED|PRIO)\]')
 KV = re.compile(r'^([a-z_]+):\s*(.*)$', re.I)
 
+# Fields whose value is an enum, not free text. A lead may pack several fields onto
+# one line, e.g. `class: 'MISCONFIG' conf: '93'`. KV captures the whole remainder as
+# the value, which previously produced the junk class `'MISCONFIG' CONF: '93'` and,
+# because fingerprint() mixes class into the digest, a junk fingerprint that defeated
+# de-duplication against the well-formed `MISCONFIG` blocks for the same root cause.
+ENUM_FIELDS = ("class", "testability", "severity")
+_ENUM_RE = re.compile(r'^[A-Z_]{2,24}$')
+
+
+def clean_enum(value):
+    """Normalize a packed enum field: drop any trailing sibling `key:` fragment, then
+    surrounding quotes/backticks. Returns None if the result is not a clean enum."""
+    if value is None:
+        return None
+    value = re.sub(r'\s+[a-z_]+\s*:.*$', '', value.strip(), flags=re.I)
+    value = value.strip().strip('`"\'').strip()
+    return value if _ENUM_RE.match(value) else None
+
