[0m$ [0mcd /tmp/opencode/cx26 && python3 - <<'PY'
import json
d=json.load(open('p1.json'))['data']['__schema']['types']
io_names=[t['name'] for t in d if t['kind']=='INPUT_OBJECT']
q1=json.load(open('q1.json'))['data']
fields={}
for i,n in enumerate(io_names):
    v=q1.get('i%d'%i) or {}
    fields[n]=[(f['name'],f) for f in (v.get('inputFields') or [])]
def flat(t):
    if t is None: return "?"
    k,n=t.get('kind'),t.get('name')
    if k in ('NON_NULL','LIST'): return k+"("+flat(t.get('ofType'))+")"
    return n or k
for n in io_names:
    for a,f in fields[n]: f['flat']=flat(f['type'])

q2=json.load(open('q2.json'))['data']['__type']['fields']
usage={}
for f in q2:
    for a in f.get('args') or []:
        t=flat(a['type'])
        for n in io_names:
            if n in t: usage.setdefault(n,[]).append(f['name'])
print("=== %d/%d INPUT_OBJECTs reachable from mutations ==="%(len(usage),len(io_names)))
for n in sorted(usage,key=lambda x:-len(usage[x])):
    print("\n%-34s <- %2d mut: %s"%(n,len(usage[n]),", ".join(sorted(set(usage[n]))[:6])))
    print("   "+", ".join("%s:%s"%(a,b['flat']) for a,b in fields[n]))
print("\n=== input objects NOT reachable from any mutation ===")
print(", ".join(n for n in io_names if n not in usage))
