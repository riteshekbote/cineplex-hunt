import re,glob
# replicate parse_blocks exactly
STOP=re.compile(r'^\s*(?:```|---|\[LEARN\]|\[PARKED\]|\[FINAL\]|\[RISK\]|\[PRIO\]|\[NEXT\]|\[NEW\])')
KV=re.compile(r'^\s*([A-Za-z_][\w-]*)\s*:\s*(.*)$')
blocks=[]
for f in sorted(glob.glob('leads/lead-*.md')):
    lines=open(f,encoding='utf-8',errors='replace').read().splitlines()
    i=0
    while i<len(lines):
        m=re.match(r'^\[HYP\]\s*(.*)$',lines[i].strip())
        if not m: i+=1; continue
        b={'title':m.group(1).strip(),'file':f}; j=i+1
        while j<len(lines):
            l=lines[j].strip()
            if not l or STOP.match(l): break
            kv=KV.match(l)
            if kv: b[kv.group(1)]=kv.group(2).strip()
            j+=1
        blocks.append(b); i=j
print("publisher-visible [HYP] blocks:",len(blocks))
import collections
c=collections.Counter(b.get('class','(none)') for b in blocks)
print("classes:",dict(c))
bad=[b for b in blocks if re.search(r'idor|bola|decode.before.gate|decodepublicid|pii',b['title'],re.I)]
print("false-IDOR leaks:",len(bad))
for b in bad[:8]: print("   LEAK:",b['title'][:80])
