os.environ.setdefault("GITHUB_REPOSITORY","local/local"); os.environ.setdefault("GITHUB_TOKEN","none")
stub=types.ModuleType("github"); stub.Github=object; sys.modules["github"]=stub
spec=importlib.util.spec_from_file_location("si","scripts/sync-issues.py")
si=importlib.util.module_from_spec(spec); spec.loader.exec_module(si)

CANON = {
 "CORS":          ("graphql-api.app.cineplex.de/", "MISCONFIG"),
 "INTROSPECTION": ("graphql-api.app.cineplex.de/graphql", "MISCONFIG"),
 "DANGLE":        ("web-dev.cineplex.de", "MISCONFIG"),
 "MASSASSIGN":    ("graphql-api.app.cineplex.de", "BUSLOGIC"),
}
RULES=[
 ("CORS", re.compile(r"\bcors\b|access-control|allow-origin|allow-credential|credentialed reflection"
                    r"|credentialed (cross-origin )?post|preflight-approves",re.I)),
 ("INTROSPECTION", re.compile(r"introspect|full[- ]schema|schema leakage|schema mirror|operation surface"
                    r"|dual entry point",re.I)),
 ("DANGLE", re.compile(r"dangl|takeover|azure container app|trusted parent domain",re.I)),
 ("MASSASSIGN", re.compile(r"mass assign|client-settable|settable from the request body|authorization flags and tenant"
                    r"|tenant membership|adminCinemaOperatingCompanyIds|accessRightDashboard|privilege flag",re.I)),
]
# unproven / awaiting program authorization -> [PARKED]
PARK = re.compile(r"testing_?get|testing_\*|confirmation-code|confirmation code|password.reset|reset.code|human_only"
                  r"|cross-tenant|cross.tenant|customer-namespace|valid jwt|userById|adminUsers|searchUsers"
                  r"|deprecat|preference|ssrf|undocumented relay|destructive mutation",re.I)
FILES=["leads/lead-bigpickle.md","leads/lead-nemotron3.md"]
APPLY = "--apply" in sys.argv
stats=collections.Counter(); report=collections.defaultdict(collections.Counter)
newfiles={}
for f in FILES:
    lines=open(f,encoding="utf-8").read().splitlines()
    out=[]; i=0
    while i<len(lines):
        m=re.match(r'^(\[HYP\])\s*(.*)$',lines[i].strip())
        if not m:
            out.append(lines[i]); i+=1; continue
        title=m.group(2); j=i+1; body=[]
        while j<len(lines):
            l=lines[j]
            if not l.strip() or si.STOP.match(l.strip()): break
            body.append(l); j+=1
        label=None
        if "<" not in title:
            for name,pat in RULES:
                if pat.search(title): label=name; break
        if label:
            canon_asset,canon_cls=CANON[label]
            keep=[l for l in body if not re.match(r'^(asset|class)\s*:',l,re.I)]
            hdr=out and lines[i].strip()
            out.append(lines[i])
            out.append(f"class: {canon_cls}")
            out.append(f"asset: {canon_asset}")
            out.extend(keep)
            stats[label]+=1; report[f][label]+=1
        else:
            if "<" in title:
                out.append(lines[i]); out.extend(body)   # parser ignores these; leave untouched
            else:
                tag="[PARKED]" if PARK.search(title) else "[LEARN]"
                out.append(lines[i].replace("[HYP]",tag,1)); out.extend(body)
                stats[tag]+=1; report[f][tag]+=1
        i=j
    newfiles[f]=out
print("planned:",dict(stats))
for f in FILES: print(" ",f,dict(report[f]))
if not APPLY:
    print("DRY RUN - pass --apply to write"); sys.exit()
for f in FILES:
    with open(f,"w",encoding="utf-8") as fh:
        fh.write("\n".join(newfiles[f])+"\n")
    print("wrote",f)
