 ('userByQr',            '{userByQr(qrCode:"0"){__typename}}'),
 ('voucherInstanceByQR', '{voucherInstanceByQR(qrCode:"0"){__typename}}'),
 ('voucherInstancesByOrderNumber','{voucherInstancesByOrderNumber(orderNumber:"0"){__typename}}'),
 ('checkVoucherCode',    '{checkVoucherCode(voucherCode:"0"){__typename}}'),
 ('getImdbIds',          '{getImdbIds(key:"0"){__typename}}'),
 ('notification',        '{notification(id:"0"){__typename}}'),
 ('targetGroup',         '{targetGroup(id:"0"){__typename}}'),
 ('beaconById',          '{beaconById(id:"0"){__typename}}'),
 ('emailComponent_id',   '{emailComponent(identifier:"0"){__typename}}'),
 ('contentSectionList',  '{contentSectionList(id:"0"){__typename}}'),
 ('cinemaCluster',       '{cinemaCluster(id:"0"){__typename}}'),
 ('newsItem',            '{newsItem(id:"0"){__typename}}'),
 ('movieList',           '{movieList(id:"0"){__typename}}'),
 ('screeningAuditorium', '{screeningAuditorium(screeningId:"0"){__typename}}'),
 ('searchMovie',         '{searchMovie(title:"zzzqqq-nope-9f3a"){__typename}}'),
 ('searchCastOrCrewMember','{searchCastOrCrewMember(fullName:"zzzqqq-nope-9f3a"){__typename}}'),
]
for name,q in probes:
    r=subprocess.run(['curl','-s','--http2','-G','-A',UA,'-H','Accept: application/json',
        '--data-urlencode','query='+q,'-w','\n@@%{http_code}','--max-time','20',HOST],
        capture_output=True,text=True)
    out=r.stdout
    try:
        body,code=out.rsplit('\n@@',1)
    except ValueError:
        print(f"{name:28s} PARSE_FAIL {out[:120]!r}"); time.sleep(2.5); continue
    blen=len(body)
    ext=''
    try:
        j=json.loads(body)
        e=j.get('errors',[{}])[0]
        ext=e.get('extensions',{}) or {}
        code_name=ext.get('code','-')
        msg=(e.get('message') or '')[:70]
        if j.get('data'): msg='DATA:'+json.dumps(j['data'])[:90]
    except Exception:
        code_name='PARSE_ERR'; msg=body[:80]
    print(f"{name:28s} HTTP {code} {blen:>5}B code={code_name:<22} {msg}")
    time.sleep(2.5)
