import os, sys, types, hashlib, json
from collections import Counter, defaultdict
from pathlib import Path

# Stub the github SDK so we can exec the publisher's OWN source (no reimplementation)
sys.modules.setdefault('github', types.ModuleType('github'))
os.environ.setdefault('GITHUB_REPOSITORY', 'local/measure')
os.environ.setdefault('GITHUB_TOKEN', 'none')

src = Path('scripts/sync-issues.py').read_text()
ns = {'__name__': 'sync_issues_measure'}   # defeats the __main__ guard
exec(compile(src, 'scripts/sync-issues.py', 'exec'), ns)

parse_blocks, fingerprint, norm_title = ns['parse_blocks'], ns['fingerprint'], ns['norm_title']

files = sorted(Path('.').glob('leads/lead-*.md'))
all_blocks = []
for f in files:
    model = f.stem.replace('lead-', '')
    bl = parse_blocks(f.read_text(errors='replace'), model)
    for b in bl:
        b['_file'] = f.name
        b['_model'] = model
        b['_fp'] = fingerprint(b)
    all_blocks.extend(bl)

fps = defaultdict(list)
for b in all_blocks:
    fps[b['_fp']].append(b)

def conf(b):
    c = b.get('confidence', '')
    m = __import__('re').match(r'^(\d{1,3})', str(c))
    return int(m.group(1)) if m else None

print(f"FILES            {len(files)}")
print(f"[HYP] BLOCKS     {len(all_blocks)}")
print(f"FINGERPRINTS     {len(fps)}")
print(f"UNIQUE TITLES    {len({norm_title(b.get('title','')) for b in all_blocks})}")
print()
print("--- blocks per file ---")
for f in files:
    n = sum(1 for b in all_blocks if b['_file'] == f.name)
    print(f"  {f.name:32} {n:6}")
print()
print("--- top 25 fingerprints by block count ---")
for fp, bl in sorted(fps.items(), key=lambda kv: -len(kv[1]))[:25]:
    c = Counter((b.get('class','OTHER') or 'OTHER').strip().upper()[:20] for b in bl)
    confs = sorted({x for x in (conf(b) for b in bl) if x is not None}, reverse=True)
    print(f"  {fp} n={len(bl):5} class={dict(c.most_common(3))} maxconf={confs[:4]} :: {bl[0].get('title','')[:74]!r}")
print()
print("--- class distribution (blocks) ---")
for k, v in Counter((b.get('class','(none)') or '(none)').strip().upper()[:20] for b in all_blocks).most_common():
    print(f"  {k:22} {v:6}")
print()
print("--- IDOR-family blocks still publishable ---")
idor = [b for b in all_blocks if (b.get('class','') or '').strip().upper() in ('IDOR','AUTHZ','ACCESS_CONTROL','BROKEN_ACCESS')]
print(f"  count={len(idor)}  fingerprints={len({b['_fp'] for b in idor})}")
print("  max confidence present:", max((conf(b) or 0 for b in idor), default=0))
Path('/tmp/opencode/cpx/blocks.json').write_text(json.dumps(all_blocks, indent=1))
